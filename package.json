{
  "name": "nuwax-devkit",
  "version": "0.0.0",
  "private": true,
  "description": "nuwax-devkit 多包仓库：stack/crew/kit 三源码包 + contracts + cli（本地预发布，不发布到 registry）",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "pack": "node scripts/pack.mjs",
    "contracts:sync": "npm --workspace @nuwax-ai/devkit-contracts run sync",
    "contracts:check": "npm --workspace @nuwax-ai/devkit-contracts run check"
  }
}
