{
  "name": "nuwax-forge",
  "version": "0.0.0",
  "private": true,
  "description": "Nuwax Forge：统一入口，Stack / Crew / Kit 内部模块",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:install && npm test --workspaces --if-present",
    "pack": "node scripts/pack.mjs",
    "contracts:sync": "npm --workspace @nuwax-ai/devkit-contracts run sync",
    "contracts:check": "npm --workspace @nuwax-ai/devkit-contracts run check",
    "test:install": "node --test scripts/offline-install.test.mjs"
  }
}
