{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nuwax verification evidence v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "recipe", "recipePath", "level", "passed", "source", "environment", "predicates", "stages", "artifacts", "command"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "nuwax-verification"},
    "recipe": {"type": "string", "minLength": 1},
    "recipePath": {"type": "string", "minLength": 1},
    "level": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "source": {
      "type": "object",
      "required": ["root", "head", "inputs", "files", "inputDigest"],
      "properties": {
        "root": {"type": "string"},
        "head": {"type": "string"},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
        "inputDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "environment": {
      "type": "object", "required": ["hostname", "platform", "arch", "node"]
    },
    "predicates": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "passed"], "properties": {"id": {"type": "string"}, "passed": {"type": "boolean"}}}
    },
    "stages": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "passed", "exitCode"]}
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "artifact": {
      "type": "object", "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    }
  }
}
